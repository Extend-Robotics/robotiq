<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="robotiq_arg2f_85_model">
  <!-- parameters -->
  <xacro:arg name="side" default="" />
  <xacro:include filename="$(find robotiq_hand_e_description)/srdf/robotiq_arg2f_85_model_macro.srdf.xacro" />
  <xacro:robotiq_hand_e_macro_srdf prefix="$(arg side)_hand_"/>
</robot>