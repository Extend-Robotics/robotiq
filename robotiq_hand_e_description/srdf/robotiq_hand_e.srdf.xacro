<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="robotiq_hand_e_model">
  <!-- parameters -->
  <xacro:arg name="side" default="" />
  <xacro:include filename="$(find robotiq_hand_e_description)/srdf/robotiq_hand_e_macro.srdf.xacro" />
  <xacro:robotiq_hand_e_model_macro_srdf prefix="$(arg side)_hand_"/>
</robot>
