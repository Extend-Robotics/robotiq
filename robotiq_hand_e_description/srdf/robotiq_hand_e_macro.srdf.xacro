<?xml version="1.0" encoding="UTF-8"?>
<!--This does not replace URDF, and is not an extension of URDF.
    This is a format for representing semantic information about the robot structure.
    A URDF file must exist for this robot as well, where the joints and the links that are referenced are defined
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="robotiq_hand_e_model">
    <xacro:macro name="robotiq_hand_e_model_macro_srdf" params="prefix:='right_hand_'">
        <!--GROUPS: Representation of a set of joints and links. This can be useful for specifying DOF to plan for, defining arms, end effectors, etc-->
        <group name="${prefix}gripper">
            <joint name="${prefix}hande_left_finger_joint"/>
            <joint name="${prefix}hande_right_finger_joint"/>
        </group>
        <!--GROUP STATES: Purpose: Define a named state for a particular group, in terms of joint values. This is useful to define states like 'folded arms'-->
        <!-- Each finger travels stroke/2: 0.025 m for the standard 50 mm Hand-E. -->
        <group_state name="close" group="${prefix}gripper">
            <joint name="${prefix}hande_left_finger_joint" value="0.025"/>
        </group_state>
        <group_state name="open" group="${prefix}gripper">
            <joint name="${prefix}hande_left_finger_joint" value="0"/>
        </group_state>
        <!--DISABLE COLLISIONS: By default it is assumed that any link of the robot could potentially come into collision with any other link in the robot. This tag disables collision checking between a specified pair of links. -->
        <disable_collisions link1="${prefix}hand_e_base_link" link2="${prefix}hande_left_finger" reason="Adjacent"/>
        <disable_collisions link1="${prefix}hand_e_base_link" link2="${prefix}hande_right_finger" reason="Adjacent"/>
        <!-- The jaws meet when fully closed by design; contact between them is not a collision. -->
        <disable_collisions link1="${prefix}hande_left_finger" link2="${prefix}hande_right_finger" reason="User"/>
    </xacro:macro>
</robot>
